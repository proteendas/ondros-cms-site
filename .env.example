# Where the marketing site's Login / Get Started CTAs send visitors
# (the authenticated Ondros CMS app). NEXT_PUBLIC_* vars are inlined into
# the client bundle at build time, so set these in Vercel's Environment
# Variables per environment (Production / Preview / Development).
NEXT_PUBLIC_APP_LOGIN_URL=http://ec2-54-206-170-82.ap-southeast-2.compute.amazonaws.com:3000/login
NEXT_PUBLIC_APP_SIGNUP_URL=http://ec2-54-206-170-82.ap-southeast-2.compute.amazonaws.com:3000/signup

# --- Code Sync reference project ---------------------------------------------
# The demo site the /docs/code-sync page tells people to copy from.
NEXT_PUBLIC_DEMO_SITE_REPO_URL=https://github.com/proteendas/ondros-demo-site
# Where that demo is deployed. Leave empty until it is — the "View the live
# demo" button renders only when this is set, so the docs never ship a dead link.
NEXT_PUBLIC_DEMO_SITE_URL=
